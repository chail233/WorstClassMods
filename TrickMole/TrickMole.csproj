<Project Sdk="Microsoft.NET.Sdk">

  <!-- 混的入：每节课随机一名学生捣蛋分 ×2，全员可见。共享属性/引用/部署见上层 Directory.Build.props 与 targets -->

  <PropertyGroup>
    <AssemblyName>TrickMole</AssemblyName>
    <RootNamespace>TrickMole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 提示盒定位读取下课倒计时 UI：Canvas / RenderMode / RectTransformUtility -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 体育生视线判定：Physics.RaycastNonAlloc / QueryTriggerInteraction -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 角色配置面板：Image/Button/InputField/CanvasScaler 等 UGUI 控件全在这个程序集（本变体无独立 EventSystems.dll） -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 广播(B)/推倒(E)键位的 KeyCode 枚举 -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
