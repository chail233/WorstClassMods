<Project Sdk="Microsoft.NET.Sdk">

  <!-- 老师奖励：三个一次性触发点（挂真人柱/捣蛋半程/老师被晕）发奖励点，按 H 开面板选技能卡（占位）。
       共享属性/引用/部署见上层 Directory.Build.props 与 targets -->

  <PropertyGroup>
    <AssemblyName>TeacherReward</AssemblyName>
    <RootNamespace>TeacherReward</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 奖励面板：Canvas / RenderMode -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 奖励面板：Image/Button/Text/CanvasScaler 等 UGUI 控件全在这个程序集（本变体无独立 EventSystems.dll） -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 面板热键 H 的 KeyCode 枚举 -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 克隆窗框时剥 Animator -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
