<Project>

  <!-- 部署目录：Mods\<程序集名>\（此文件在子项目求值之后导入，此时 AssemblyName 已确定） -->
  <PropertyGroup>
    <ModOutDir>$(GameDir)\Mods\$(AssemblyName)</ModOutDir>
  </PropertyGroup>

  <!-- 构建后把 DLL + mod.json + Music 目录一起部署到 Mods\<程序集名>\
       非 Mod 工具（如 Workshop/Uploader）在 csproj 里设 IsGameMod=false 跳过部署 -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(IsGameMod)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutDir)\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\mod.json" DestinationFolder="$(ModOutDir)\" Condition="Exists('$(MSBuildProjectDirectory)\mod.json')" />
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Music')">
      <ModMusicFiles Include="$(MSBuildProjectDirectory)\Music\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModMusicFiles)"
          DestinationFiles="@(ModMusicFiles->'$(ModOutDir)\Music\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
